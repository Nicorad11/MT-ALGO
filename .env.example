# Copy this file to .env and fill in your key. Never put your MT5 password here:
# Opus Trader attaches to the MT5 terminal you are already logged in to.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: full path to terminal64.exe if you have more than one MT5 installed.
# MT5_TERMINAL_PATH=C:\Program Files\OANDA TMS MT5 Terminal\terminal64.exe
